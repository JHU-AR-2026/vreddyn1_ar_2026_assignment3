  <style>
    html,body,#renderCanvas{width:100%;height:100%;margin:0;padding:0;overflow:hidden;background:#000}
  </style>
</head>
<body>
  <canvas id="renderCanvas"></canvas>
  <script type="module">
    // Turn bundle text into a module URL
    const code = "// snapshot:index.js\nvar MODEL_FOLDER = \"https://raw.githubusercontent.com/VivekRnx/ar-models/main/\";\nvar MODEL_FILE = \"majestic_sword.glb\";\nvar MODEL_SIZE = 0.3;\nvar MAX_DISTANCE = 10;\nvar MOVE_SPEED = 0.5;\nvar STICK_DEADZONE = 0.15;\nvar TURN_SPEED = Math.PI / 2;\nvar SCALE_STEP = 1.1;\nvar MIN_SCALE = 0.05;\nvar MAX_SCALE = 20;\nvar createScene = async function() {\n  const scene = new BABYLON.Scene(engine);\n  scene.clearColor = new BABYLON.Color4(0, 0, 0, 0);\n  const camera = new BABYLON.FreeCamera(\"camera\", new BABYLON.Vector3(0, 1.6, -2), scene);\n  camera.setTarget(new BABYLON.Vector3(0, 0.5, 1));\n  camera.attachControl(canvas, true);\n  const hemiLight = new BABYLON.HemisphericLight(\"hemiLight\", new BABYLON.Vector3(0, 1, 0), scene);\n  hemiLight.intensity = 0.8;\n  const sunLight = new BABYLON.DirectionalLight(\"sunLight\", new BABYLON.Vector3(-0.5, -1, 0.5), scene);\n  sunLight.intensity = 0.6;\n  const container = await BABYLON.SceneLoader.LoadAssetContainerAsync(MODEL_FOLDER, MODEL_FILE, scene);\n  const reticle = BABYLON.MeshBuilder.CreateTorus(\n    \"reticle\",\n    { diameter: 0.12, thickness: 0.01, tessellation: 32 },\n    scene\n  );\n  const reticleMaterial = new BABYLON.StandardMaterial(\"reticleMaterial\", scene);\n  reticleMaterial.emissiveColor = new BABYLON.Color3(0.1, 1, 0.3);\n  reticleMaterial.disableLighting = true;\n  reticle.material = reticleMaterial;\n  reticle.rotationQuaternion = BABYLON.Quaternion.Identity();\n  reticle.isPickable = false;\n  reticle.setEnabled(false);\n  let spawnCount = 0;\n  let current = null;\n  let latestHit = null;\n  let rightStick = null;\n  let leftStick = null;\n  function getHierarchyBounds(node) {\n    node.computeWorldMatrix(true);\n    node.getDescendants(false).forEach((n) => n.computeWorldMatrix && n.computeWorldMatrix(true));\n    const min = new BABYLON.Vector3(Infinity, Infinity, Infinity);\n    const max = new BABYLON.Vector3(-Infinity, -Infinity, -Infinity);\n    node.getChildMeshes(false).forEach((mesh) => {\n      if (mesh.getTotalVertices() === 0) return;\n      const box = mesh.getBoundingInfo().boundingBox;\n      min.minimizeInPlace(box.minimumWorld);\n      max.maximizeInPlace(box.maximumWorld);\n    });\n    return { min, max };\n  }\n  function spawnModel(position) {\n    spawnCount++;\n    const root = new BABYLON.TransformNode(\"model\" + spawnCount, scene);\n    const fit = new BABYLON.TransformNode(\"model\" + spawnCount + \"_fit\", scene);\n    fit.parent = root;\n    const instance = container.instantiateModelsToScene((name) => name + \"_\" + spawnCount, false);\n    instance.rootNodes.forEach((node) => {\n      node.parent = fit;\n    });\n    instance.animationGroups.forEach((group) => group.stop());\n    if (instance.animationGroups.length > 0) instance.animationGroups[0].play(true);\n    root.getChildMeshes(false).forEach((mesh) => {\n      mesh.isPickable = false;\n    });\n    const raw = getHierarchyBounds(root);\n    const size = raw.max.subtract(raw.min);\n    const fitScale = MODEL_SIZE / Math.max(size.x, size.y, size.z, 1e-6);\n    fit.scaling.setAll(fitScale);\n    const scaled = getHierarchyBounds(root);\n    fit.position.set(\n      -(scaled.min.x + scaled.max.x) / 2,\n      -scaled.min.y,\n      -(scaled.min.z + scaled.max.z) / 2\n    );\n    root.position.copyFrom(position);\n    const toUser = scene.activeCamera.globalPosition.subtract(position);\n    root.rotation.y = Math.atan2(toUser.x, toUser.z);\n    root.metadata = {\n      initialPosition: root.position.clone(),\n      initialRotation: root.rotation.clone(),\n      initialScaling: root.scaling.clone()\n    };\n    current = root;\n    return root;\n  }\n  const xr = await scene.createDefaultXRExperienceAsync({\n    uiOptions: {\n      sessionMode: \"immersive-ar\",\n      referenceSpaceType: \"local-floor\"\n    },\n    optionalFeatures: [\"hit-test\"],\n    ignoreNativeCameraTransformation: true,\n    disableTeleportation: true,\n    disableNearInteraction: true,\n    disableHandTracking: true,\n    pointerSelectionOptions: {\n      enablePointerSelectionOnAllControllers: true,\n      maxPointerDistance: MAX_DISTANCE\n    }\n  });\n  if (!xr.baseExperience || !xr.input) {\n    return scene;\n  }\n  const sessionManager = xr.baseExperience.sessionManager;\n  if (xr.pointerSelection) {\n    xr.pointerSelection.raySelectionPredicate = () => false;\n    xr.pointerSelection.displayLaserPointer = true;\n    xr.pointerSelection.displaySelectionMesh = false;\n  }\n  xr.baseExperience.onStateChangedObservable.add((state) => {\n    if (state !== BABYLON.WebXRState.IN_XR) {\n      reticle.setEnabled(false);\n      latestHit = null;\n    }\n  });\n  let rightController = null;\n  let hitTestSource = null;\n  let hitTestUnavailable = false;\n  const pointerRay = new BABYLON.Ray(BABYLON.Vector3.Zero(), BABYLON.Vector3.Forward(), MAX_DISTANCE);\n  xr.input.onControllerAddedObservable.add((controller) => {\n    const hand = controller.inputSource.handedness;\n    if (hand === \"right\") {\n      rightController = controller;\n      let disposed = false;\n      controller.onDisposeObservable.addOnce(() => {\n        disposed = true;\n        if (rightController === controller) rightController = null;\n        if (hitTestSource) hitTestSource.cancel();\n        hitTestSource = null;\n      });\n      const session = sessionManager.session;\n      if (session && session.requestHitTestSource) {\n        session.requestHitTestSource({ space: controller.inputSource.targetRaySpace }).then((source) => {\n          if (disposed) source.cancel();\n          else hitTestSource = source;\n        }).catch((error) => {\n          console.warn(\"Controller hit test unavailable:\", error);\n          hitTestUnavailable = true;\n        });\n      } else {\n        console.warn(\"WebXR hit test is not supported on this device.\");\n        hitTestUnavailable = true;\n      }\n    }\n    controller.onMotionControllerInitObservable.add((motionController) => {\n      if (hand === \"right\") {\n        const trigger = motionController.getComponent(\"xr-standard-trigger\");\n        if (trigger) {\n          trigger.onButtonStateChangedObservable.add(() => {\n            if (!trigger.changes.pressed || !trigger.pressed) return;\n            if (xr.baseExperience.state !== BABYLON.WebXRState.IN_XR) return;\n            if (!latestHit) return;\n            spawnModel(latestHit.position);\n          });\n        }\n        const stick = motionController.getComponent(\"xr-standard-thumbstick\");\n        if (stick) {\n          rightStick = stick;\n          controller.onDisposeObservable.addOnce(() => {\n            if (rightStick === stick) rightStick = null;\n          });\n        }\n        const aButton = motionController.getComponent(\"a-button\");\n        if (aButton) {\n          aButton.onButtonStateChangedObservable.add(() => {\n            if (aButton.changes.pressed && aButton.pressed) scaleCurrent(SCALE_STEP);\n          });\n        }\n        const bButton = motionController.getComponent(\"b-button\");\n        if (bButton) {\n          bButton.onButtonStateChangedObservable.add(() => {\n            if (bButton.changes.pressed && bButton.pressed) scaleCurrent(1 / SCALE_STEP);\n          });\n        }\n      }\n      if (hand === \"left\") {\n        const stick = motionController.getComponent(\"xr-standard-thumbstick\");\n        if (stick) {\n          leftStick = stick;\n          controller.onDisposeObservable.addOnce(() => {\n            if (leftStick === stick) leftStick = null;\n          });\n        }\n        const xButton = motionController.getComponent(\"x-button\");\n        if (xButton) {\n          xButton.onButtonStateChangedObservable.add(() => {\n            if (xButton.changes.pressed && xButton.pressed) resetCurrent();\n          });\n        }\n      }\n    });\n  });\n  sessionManager.onXRFrameObservable.add((frame) => {\n    latestHit = null;\n    if (!rightController) {\n      reticle.setEnabled(false);\n      return;\n    }\n    if (hitTestSource) {\n      const hit = frame.getHitTestResults(hitTestSource)[0];\n      const pose = hit && hit.getPose(sessionManager.referenceSpace);\n      if (pose) {\n        const matrix = BABYLON.Matrix.FromArray(pose.transform.matrix);\n        if (!scene.useRightHandedSystem) {\n          matrix.toggleModelMatrixHandInPlace();\n        }\n        const position = matrix.getTranslation().scaleInPlace(sessionManager.worldScalingFactor);\n        rightController.getWorldPointerRayToRef(pointerRay);\n        if (BABYLON.Vector3.Distance(pointerRay.origin, position) <= MAX_DISTANCE) {\n          latestHit = { position };\n          reticle.position.copyFrom(position);\n          BABYLON.Quaternion.FromRotationMatrixToRef(matrix, reticle.rotationQuaternion);\n        }\n      }\n    } else if (hitTestUnavailable) {\n      rightController.getWorldPointerRayToRef(pointerRay);\n      const dir = pointerRay.direction;\n      if (dir.y < -1e-3) {\n        const t = -pointerRay.origin.y / dir.y;\n        if (t <= MAX_DISTANCE) {\n          const position = pointerRay.origin.add(dir.scale(t));\n          latestHit = { position };\n          reticle.position.copyFrom(position);\n          reticle.rotationQuaternion.copyFrom(BABYLON.Quaternion.Identity());\n        }\n      }\n    }\n    reticle.setEnabled(latestHit !== null);\n  });\n  function readStick(stick) {\n    const x = Math.abs(stick.axes.x) > STICK_DEADZONE ? stick.axes.x : 0;\n    const y = Math.abs(stick.axes.y) > STICK_DEADZONE ? stick.axes.y : 0;\n    return { x, y };\n  }\n  scene.onBeforeRenderObservable.add(() => {\n    if (!current || !rightStick) return;\n    const { x, y } = readStick(rightStick);\n    if (x === 0 && y === 0) return;\n    const cam = scene.activeCamera;\n    const forward = cam.getDirection(BABYLON.Axis.Z);\n    forward.y = 0;\n    if (forward.lengthSquared() < 1e-6) return;\n    forward.normalize();\n    const right = BABYLON.Vector3.Cross(BABYLON.Axis.Y, forward);\n    const step = MOVE_SPEED * engine.getDeltaTime() / 1e3;\n    current.position.addInPlace(right.scale(x * step));\n    current.position.addInPlace(forward.scale(-y * step));\n  });\n  scene.onBeforeRenderObservable.add(() => {\n    if (!current || !leftStick) return;\n    const { x } = readStick(leftStick);\n    if (x === 0) return;\n    current.rotation.y += x * TURN_SPEED * engine.getDeltaTime() / 1e3;\n  });\n  function scaleCurrent(factor) {\n    if (!current) return;\n    const s = BABYLON.Scalar.Clamp(current.scaling.x * factor, MIN_SCALE, MAX_SCALE);\n    current.scaling.setAll(s);\n  }\n  function resetCurrent() {\n    if (!current || !current.metadata) return;\n    current.position.copyFrom(current.metadata.initialPosition);\n    current.rotation.copyFrom(current.metadata.initialRotation);\n    current.scaling.copyFrom(current.metadata.initialScaling);\n  }\n  return scene;\n};\nexport {\n  createScene\n};\n//# sourceMappingURL=data:application/json;base64,\n";
    const blob = new Blob([code], { type: 'text/javascript' });
    const url = URL.createObjectURL(blob);

    const BABYLON = window.BABYLON;
    const canvas = document.getElementById('renderCanvas');

    // Import your bundled app (which exports createScene / default)
    const mod = await import(url);

    let engine = null;
    if (typeof mod.createEngine === 'function') {
      try { engine = await mod.createEngine(); } catch {}
    }
    if (!engine) {
      engine = new BABYLON.Engine(canvas, true, { preserveDrawingBuffer: true, stencil: true });
    }
    window.engine = engine; window.canvas = canvas;

    let createScene = mod.createScene || mod.default;
    if (!createScene && mod.Playground?.CreateScene) createScene = (e,c)=>mod.Playground.CreateScene(e,c);
    if (!createScene) throw new Error('No createScene() export found.');

    const scene = await (createScene(engine, canvas) ?? createScene());
    engine.runRenderLoop(()=>scene.render());
    addEventListener('resize', ()=>engine.resize());

    addEventListener('unload', ()=> URL.revokeObjectURL(url));
  </script>
</body>
</html>
